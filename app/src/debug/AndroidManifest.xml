<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/debug_network_security_config"
        android:usesCleartextTraffic="true">
        <receiver
            android:name="com.example.planner.PlannerReminderAcceptanceReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.debug.TRIGGER_PLANNER_REMINDERS" />
                <action android:name="com.example.debug.REPOST_LAST_PLANNER_REMINDER" />
                <action android:name="com.example.debug.VALIDATE_LAST_PLANNER_REMINDER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
