{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human.local/schemas/runtime-catalogue-contract-v2.schema.json",
  "title": "Human Exercise Runtime Catalogue Release v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_contract_version",
    "schema_version",
    "catalogue_version",
    "source_catalogue_commit",
    "channel",
    "distribution_scope",
    "record_count",
    "exercises",
    "checksum"
  ],
  "properties": {
    "runtime_contract_version": { "const": 2 },
    "schema_version": { "const": "2.0" },
    "catalogue_version": { "type": "string", "minLength": 1 },
    "source_catalogue_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "channel": { "enum": ["pilot_staging", "production"] },
    "distribution_scope": { "const": "official_catalogue_release" },
    "record_count": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "exercises": {
      "type": "array",
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "display_name",
        "classification",
        "search",
        "anatomy",
        "equipment",
        "coaching",
        "relationships",
        "measurement_modes"
      ],
      "properties": {
        "canonical_id": { "$ref": "#/$defs/slug" },
        "display_name": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "#/$defs/classification" },
        "search": { "$ref": "#/$defs/search" },
        "anatomy": { "$ref": "#/$defs/anatomy" },
        "equipment": { "$ref": "#/$defs/equipment" },
        "coaching": { "$ref": "#/$defs/coaching" },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "measurement_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measurementMode" }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "movement_pattern",
        "difficulty",
        "laterality",
        "compound_or_isolation"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/slug" },
        "movement_pattern": { "$ref": "#/$defs/slug" },
        "difficulty": { "$ref": "#/$defs/slug" },
        "laterality": { "$ref": "#/$defs/slug" },
        "compound_or_isolation": { "$ref": "#/$defs/slug" }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "keywords"],
      "properties": {
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "keywords": { "$ref": "#/$defs/stringArray" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "normalised", "type"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "normalised": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["search", "regional", "abbreviation", "legacy"]
        },
        "locale": { "type": ["string", "null"] }
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_muscles",
        "secondary_muscles",
        "stabiliser_muscles"
      ],
      "properties": {
        "primary_muscles": { "$ref": "#/$defs/stringArray" },
        "secondary_muscles": { "$ref": "#/$defs/stringArray" },
        "stabiliser_muscles": { "$ref": "#/$defs/stringArray" }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "attachments"],
      "properties": {
        "required": { "$ref": "#/$defs/stringArray" },
        "attachments": { "$ref": "#/$defs/stringArray" }
      }
    },
    "coaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "execution",
        "common_errors",
        "breathing_bracing",
        "range_of_motion",
        "safety"
      ],
      "properties": {
        "setup": { "type": "string" },
        "execution": { "type": "string" },
        "common_errors": { "type": "string" },
        "breathing_bracing": { "type": "string" },
        "range_of_motion": { "type": "string" },
        "safety": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_canonical_id"],
      "properties": {
        "type": {
          "enum": ["parent", "progression", "regression", "supersedes"]
        },
        "target_canonical_id": { "$ref": "#/$defs/slug" }
      }
    },
    "measurementField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "unit"],
      "properties": {
        "measurement": {
          "enum": [
            "reps",
            "load",
            "duration",
            "distance",
            "rpe",
            "assistance",
            "calories",
            "power",
            "cadence",
            "heart_rate",
            "resistance",
            "speed",
            "pace",
            "count",
            "vertical_distance"
          ]
        },
        "unit": {
          "enum": [
            "count",
            "kilograms",
            "seconds",
            "metres",
            "rpe_scale",
            "kilocalories",
            "watts",
            "repetitions_per_minute",
            "beats_per_minute",
            "resistance_level",
            "metres_per_second",
            "seconds_per_metre"
          ]
        }
      }
    },
    "measurementMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_id",
        "is_default",
        "required",
        "optional",
        "load_semantics",
        "derived_metrics",
        "measurement_schema_version"
      ],
      "properties": {
        "mode_id": { "$ref": "#/$defs/slug" },
        "is_default": { "type": "boolean" },
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurementField" }
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurementField" }
        },
        "load_semantics": {
          "enum": [
            "none",
            "external_load",
            "added_load",
            "assistance",
            "bodyweight"
          ]
        },
        "derived_metrics": {
          "type": "array",
          "items": { "enum": ["pace", "speed"] },
          "uniqueItems": true
        },
        "measurement_schema_version": { "const": 1 }
      }
    }
  }
}
